# vim: ft=zsh sw=2 ts=2 et
_history_search_multi_word_ctx_prev_idx="$_history_search_multi_word_ctx_idx"

[[ "$WIDGET" = *-word ]] && (( _history_search_multi_word_ctx_idx -- ))
[[ "$WIDGET" = *-backwards ]] && (( _history_search_multi_word_ctx_idx ++ ))
[[ "$WIDGET" = *-pforwards ]] && (( _history_search_multi_word_ctx_idx = _history_search_multi_word_ctx_idx - _history_search_multi_word_page_size ))
[[ "$WIDGET" = *-pbackwards ]] && (( _history_search_multi_word_ctx_idx = _history_search_multi_word_ctx_idx + _history_search_multi_word_page_size ))

_history_search_multi_word_ctx_up() {
  (( _history_search_multi_word_ctx_which -- ))
  (( _history_search_multi_word_ctx_which < 0 )) && _history_search_multi_word_ctx_which=${#_history_search_multi_word_ctx_found}-1
  _history_search_multi_word_ctx_idx=0
  _history_search_multi_word_ctx_main
}

_history_search_multi_word_ctx_down() {
  (( _history_search_multi_word_ctx_which ++ ))
  (( _history_search_multi_word_ctx_which >= ${#_history_search_multi_word_ctx_found} )) && _history_search_multi_word_ctx_which=0
  _history_search_multi_word_ctx_idx=0
  _history_search_multi_word_ctx_main
}

_history_search_multi_word_ctx_off() {
  _history_search_multi_word_ctx_to_search=""
  _history_search_multi_word_ctx_found=( )
  _history_search_multi_word_ctx_which=0
  _history_search_multi_word_ctx_idx=0
  _history_search_multi_word_ctx_page_start_idx=0
  _history_search_multi_word_ctx_prev_offset=0
  _history_search_multi_word_ctx=0

  # Reset main state so that it re-highlights
  _history_search_multi_word_prev_offset=0

  zle -la _history_search_multi_word_ctx_down && zle -D _history_search_multi_word_ctx_down
  zle -la _history_search_multi_word_ctx_up && zle -D _history_search_multi_word_ctx_up

  bindkey -M history-search-multi-word '^N' "history-search-multi-word"
  bindkey -M history-search-multi-word '^P' "history-search-multi-word-backwards"

  (( ${1}+0 )) && _history_search_multi_word_simulate_widget
}

if [[ "$WIDGET" = "_history_search_multi_word_context" ]]; then
  _history_search_multi_word_ctx=1-_history_search_multi_word_ctx
  if (( _history_search_multi_word_ctx == 0 )); then
    _history_search_multi_word_ctx_off 1
    return
  fi

  zle -N _history_search_multi_word_ctx_down
  zle -N _history_search_multi_word_ctx_up
  bindkey -M history-search-multi-word '^N' "_history_search_multi_word_ctx_down"
  bindkey -M history-search-multi-word '^P' "_history_search_multi_word_ctx_up"
fi

_history_search_multi_word_ctx_main() {
  # The repeat will make the matching work on a fresh heap arena
  local to_search="${_history_search_multi_word_hcw_found[_history_search_multi_word_hcw_index]}" nl=$'\n'
  to_search="${to_search//(#m)[][*?|#~^()><\\]/\\$MATCH}"
  if [[ "$to_search" != "$_history_search_multi_word_ctx_to_search" ]]; then
    _history_search_multi_word_ctx_to_search="$to_search"; repeat 1
    do
      _history_search_multi_word_ctx_found=( "${(@kv)history[(R)$to_search]}" )
      _history_search_multi_word_ctx_text_idx="${_history_search_multi_word_ctx_found[(I)$to_search]}"
      if [[ "$_history_search_multi_word_ctx_text_idx" = "0" ]]; then
        _history_search_multi_word_ctx_off 1
        return 0
      fi
      _history_search_multi_word_ctx_found[_history_search_multi_word_ctx_text_idx]=()
    done
  fi

  integer final_hist_found_idx
  final_hist_found_idx=_history_search_multi_word_ctx_text_idx+_history_search_multi_word_ctx_which-1

  integer the_index="${_history_search_multi_word_ctx_found[final_hist_found_idx]}"
  the_index=the_index+_history_search_multi_word_ctx_idx

  integer max_index=$(( ${${(k)history[@]}[1]} + 1 ))
  if [[ "$max_index" -le "0" ]]; then
    POSTDISPLAY=$'\n'"No matches found"
    return 0
  fi

#
# Pagination, index value guards
#

integer page_size="$_history_search_multi_word_page_size"
[[ "$page_size" -gt "$max_index" ]] && page_size="$max_index"
[[ "$the_index" -le 0 ]] && { _history_search_multi_word_ctx_idx="$_history_search_multi_word_ctx_prev_idx"; the_index=1; }
[[ "$the_index" -gt "$(( max_index - 1))" ]] && { _history_search_multi_word_ctx_idx="$_history_search_multi_word_ctx_prev_idx"; the_index="$(( max_index - 1 ))"; }
integer page_start_idx=$(( ((the_index-1)/page_size)*page_size+1 ))
integer on_page_idx=$(( page_size - (the_index - page_start_idx) ))

#
# Prepare display
#

  if [[ "$page_start_idx" != "$_history_search_multi_word_ctx_page_start_idx" ]]; then
    integer idx
    _history_search_multi_word_ctx_disp_list=( )
    for (( idx = page_start_idx + page_size - 1; idx >= page_start_idx ; idx -- )); do
      _history_search_multi_word_ctx_disp_list+=( "${history[$idx]}" )
    done
    # Don't do @ splitting, it's slower
    _history_search_multi_word_ctx_disp_list_newlines=( "${_history_search_multi_word_ctx_disp_list[@]}" )
    # Replace all new lines with "\n" text
    _history_search_multi_word_ctx_disp_list=( "${(@)_history_search_multi_word_ctx_disp_list//$'\n'/\\n}" )
    # Truncate to display width, preceede by two spaces
    _history_search_multi_word_ctx_disp_list=( "${(@)_history_search_multi_word_ctx_disp_list/(#m)*/  ${MATCH[1,COLUMNS-8]}}" )
    # The same with newlines adapted for syntax highlighting
    _history_search_multi_word_ctx_disp_list_newlines=( "${(@)_history_search_multi_word_ctx_disp_list_newlines//$'\n'/ $nl}" )
    _history_search_multi_word_ctx_disp_list_newlines=( "${(@)_history_search_multi_word_ctx_disp_list_newlines/(#m)*/  ${MATCH[1,COLUMNS-8]}}" )
  fi

#
# Detect where "> .." entry starts, add the ">" mark
#

local txt_before="${(F)${(@)_history_search_multi_word_ctx_disp_list[1,on_page_idx-1]}}"
local entry="${_history_search_multi_word_ctx_disp_list[on_page_idx]}"
local text="${(F)_history_search_multi_word_ctx_disp_list}"
integer replace_idx=${#txt_before}+2
(( replace_idx == 2 )) && replace_idx=1
text[replace_idx]=">"

#
# Colorify
#

  local preamble=$'\n'"Showing context of history entry. Ctrl-K to return to search."
  local preamble2=$'\n'"Ctrl-N/P: next/previous occurence. Occurence #$(( _history_search_multi_word_ctx_which + 1 )) of ${#_history_search_multi_word_ctx_found}"
  preamble2=${(r:${#preamble}:: :)preamble2}$'\n'
  preamble+=$preamble2
  integer offset=${#preamble}+${#BUFFER}
  POSTDISPLAY="$preamble$text"
  if (( page_start_idx != _history_search_multi_word_ctx_page_start_idx || offset != _history_search_multi_word_ctx_prev_offset )); then
    region_highlight=( "${#BUFFER} $offset bg=22" )
    if (( _history_search_multi_word_synhl )); then
      integer pre_index=$offset
      local line
      for line in "${_history_search_multi_word_ctx_disp_list_newlines[@]}"; do
        reply=( )
        _history_search_multi_word_highlight_process "$line" "$pre_index"
        region_highlight+=( $reply )
        pre_index+=${#line}+1
      done
    fi
  else
    region_highlight[-1]=()
  fi
  _history_search_multi_word_ctx_page_start_idx=page_start_idx
  _history_search_multi_word_ctx_prev_offset=offset
  region_highlight+=( "$(( offset + ${#txt_before} )) $(( offset + ${#txt_before} + ${#entry} + 1 )) $_history_search_multi_word_active" )
}

_history_search_multi_word_ctx_main
